{
    "schemaVersion": 1,
    "id": "scathapro",
    "version": "${version}",
    "name": "Scatha-Pro",
    "description": "A mod for improved Scatha farming on Hypixel SkyBlock",
    "authors": [
        "NamelessJu"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/scatha-pro",
        "sources": "https://github.com/NamelessJu/Scatha-Pro",
        "issues": "https://github.com/NamelessJu/Scatha-Pro/issues"
    },
    "license": "ARR",
    "icon": "assets/scathapro/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "namelessju.scathapro.ScathaProFabricClient"
        ],
        "modmenu": [
            "namelessju.scathapro.apis.ModMenuApiImplementation"
        ]
    },
    "mixins": [
        {
            "config": "scathapro.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.6",
        "minecraft": ">=26.2",
        "java": ">=25",
        "fabric-api": "*",
        "hypixel-mod-api": ">=1.0.2"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/GYrFjRnytV"
            },
            "update_checker": true
        },
        "firmament:hide_from_modlist": true
    }
}